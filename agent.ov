// agent :: agent.ov
//
// The agent, as a chat. `ovc pkg install agent`, then `ovc agent`.
//
// Ask for something in words; the model runs commands on the machine to answer,
// taking as many turns as it needs, and the guard decides what it may run.
//
// import "ai", import "agent/guard"
//
// It asks for the endpoint once and remembers it in ~/.ovyth/agent.json; after
// that you just type. Slash commands: :help :config :readonly :tools :reset.
//
//   you> what is the biggest directory under /etc?
//     ⬡ du -sh /etc --max-depth=1 | sort -rh | head -3
//     ⬡ exit 0 in 24ms
//     Ovyth: /etc/skel, at 85M.
//
// The model has four tools, all of them ordinary calls: a shell command
// (os.run), reading a file, writing a file, and saying something back. It picks
// one per turn, sees the result, and continues until it has an answer -- so a
// question that needs three commands still takes one turn from your side.
//
// Slash commands: :help :config :readonly :tools :clear :reset :quit
//
// Decoration is emitted only when stdout is a terminal (os.tty()), so piping
// this into a file or a log stays clean and greppable.

import "ai"
import "agent/guard"
import "agent/json"
import "agent/do"

// ------------------------------------------------------------------- style

// ANSI, as string literals: the language has no colour API, and it does not
// need one. Everything here is gated on os.tty(), so a pipe gets plain text.
pretty = os.tty()
dim = ""
bold = ""
cyan = ""
yellow = ""
reset = ""
if pretty {
    dim = "\033[2m"
    bold = "\033[1m"
    cyan = "\033[36m"
    yellow = "\033[33m"
    reset = "\033[0m"
}

function mark(what, text) {
    if pretty {
        print("  " + cyan + what + " " + reset + text)
    } else {
        print("  " + what + " " + text)
    }
}

function side(text) {   // the assistant's own voice
    if pretty {
        print(bold + text + reset)
    } else {
        print(text)
    }
}

// ------------------------------------------------------------------ config

// Where the endpoint lives, so it is asked for once and never again.
config_path = env_or("OVC_AGENT_CONFIG", env_or("HOME", "") + "/.ovyth/agent.json")

config = {}
if file.exists(config_path) {
    text = file.read(config_path)
    if text != "" { config = json.parse(text) }
}

key = env_or("AI_API_KEY", "")
url = env_or("AI_API_URL", "")
model = env_or("AI_MODEL", "")
if key == "" and config["key"] != null { key = config["key"] }
if url == "" and config["url"] != null { url = config["url"] }
if model == "" and config["model"] != null { model = config["model"] }

if url == "" { url = "https://api.example.com/v1/chat" }
if model == "" { model = "gpt-4o-mini" }
guard_on = true

function save_config() {
    file.write(config_path, json.stringify({
        "key": key, "url": url, "model": model
    }))
}

if pretty { print("\n") }
if key == "" {
    print("first run: where should the agent talk to?")
    print("(stored in " + config_path + "; set AI_API_KEY to skip this)")
    print("")
    // input() returns null at end-of-input, not "", so each answer is checked
    // against both -- comparing only against "" would store null over a default
    // and the model line would read "nil".
    k = input("  API key   > ")
    u = input("  base URL  > ")
    m = input("  model     > ")
    if k != null and k != "" { key = k }
    if u != null and u != "" { url = u }
    if m != null and m != "" { model = m }
    save_config()
    print("")
}

// ------------------------------------------------------------------- sprite

if pretty {
    print("   \033[35m✦\033[0m")
    print("       /\\      /\\          \033[1mO v y t h\033[0m \033[35m✦\033[0m  \033[2magent\033[0m")
    print("      /  \\____/  \\         \033[2ma tiny compiled language\033[0m")
    print("     |  *      *  |")
    print("     |      w      |")
    print("     |   '----'   |")
    print("      \\          /")
    print("       '.______.'")
    print("         |  |")
    print("        (_)(_)")
    print("")
}

print("model:  " + model + "  at  " + url)
print("guard:  " + (guard_on ? "on" : "off") + "  (refuses the unrebuildable)")
print("type :help for commands, :quit to leave")
print("")

// -------------------------------------------------------------- the prompt

// What the model is told about itself and its tools. Four JSON commands, one
// per turn, and the loop below is the interpreter of that protocol.
system = "You are Ovyth, an agent running in a Linux terminal. You have four tools.\n" +
    "Each turn, reply with exactly one JSON object and nothing else:\n" +
    "  {\"cmd\": \"<shell command>\"}   run a command\n" +
    "  {\"read\": \"<path>\"}           read a file\n" +
    "  {\"write\": \"<path>\", \"text\": \"<content>\"}   write a file\n" +
    "  {\"say\": \"<text>\"}            answer the user in words\n" +
    "Prefer fewer commands. Read before you write. If a command fails, read the\n" +
    "error and try something else. Never invent output you did not observe.\n" +
    "You are talking to a person, so answers should be short and concrete.\n" +
    "You cannot open windows or see a screen. Saying you are a text assistant\n" +
    "is a wrong answer -- if you can do it with a command, send the command."

history = ai_conversation(system)

// A refusal is fed back to the model as an observation carrying the reason, so
// it adapts rather than retrying the same command.
function refused(why) {
    if pretty {
        print("  " + yellow + "✕ " + why + reset)
    } else {
        print("  refused: " + why)
    }
    return "refused by the guard: " + why + "\nChoose a different command."
}

// -------------------------------------------------------------------- tools

// One tool call, run. Returns the text that goes back to the model -- always a
// string, so the protocol never has to describe a shape.
function run_tool(call) {
    if call["cmd"] != null {
        cmd = call["cmd"]
        g = guard(cmd)
        if !g["ok"] {
            return refused(g["why"])
        }
        t0 = time.clock()
        r = os.run(cmd)
        took = round((time.clock() - t0) * 1000.0)
        mark("⬡", cmd)
        mark(" ", "exit " + str(r["code"]) + " in " + str(took) + "ms")
        out = r["stdout"].trim()
        err = r["stderr"].trim()
        shown = ""
        i = 0
        for line in out.split("\n") {
            if i >= 20 { shown = shown + dim + "… " + str(len(out.split("\n")) - 20) + " more lines" + reset + "\n"; break }
            shown = shown + dim + "  │ " + line + reset + "\n"
            i = i + 1
        }
        if shown != "" { print(shown) }
        if err != "" { print(dim + "  ! " + err.slice(0, 200) + reset) }
        return "exit " + str(r["code"]) + "\nstdout:\n" + out.slice(0, 3000) +
               (len(out) > 3000 ? "\n... " + str(len(out) - 3000) + " bytes omitted" : "") +
               "\nstderr:\n" + err.slice(0, 500)
    }
    if call["read"] != null {
        path = call["read"]
        mark("⬡", "read " + path)
        if !file.exists(path) { return "no such file: " + path }
        text = file.read(path)
        return text.slice(0, 3000) + (len(text) > 3000 ? "\n... " + str(len(text) - 3000) + " bytes omitted" : "")
    }
    if call["write"] != null {
        path = call["write"]
        mark("⬡", "write " + path)
        ok = file.write(path, call["text"])
        return ok ? "wrote " + str(len(call["text"])) + " bytes to " + path
                  : "could not write " + path
    }
    return null   // not a tool call
}

function commands(text) {
    if text == ":quit" or text == ":exit" or text == ":q" { return false }
    if text == ":help" {
        print("  :help          this")
        print("  :config        show the endpoint; :config key|url|model <value> to change")
        print("  :readonly on|off   the guard that refuses the unrebuildable")
        print("  :tools         what the model can do")
        print("  :clear         clear the screen")
        print("  :reset         forget the conversation")
        print("  :quit          leave")
        return true
    }
    if text == ":tools" {
        print("  the model may, one per turn:")
        print("    {\"cmd\": \"...\"}                  run a shell command")
        print("    {\"read\": \"path\"}               read a file")
        print("    {\"write\": \"path\", \"text\": \"…\"} write a file")
        print("    {\"say\": \"text\"}                answer you")
        return true
    }
    if text == ":clear" {
        if pretty { print("\033[2J\033[H") }
        return true
    }
    if text == ":reset" {
        history = ai_conversation(system)
        print("  conversation cleared")
        return true
    }
    if text == ":config" {
        print("  key   " + (key == "" ? "(none)" : "set, " + str(len(key)) + " chars"))
        print("  url   " + url)
        print("  model " + model)
        return true
    }
    if text.startswith(":") {
        print("  unknown command: " + text + "  (:help)")
        return true
    }
    return true
}

// ---------------------------------------------------------------- main loop

while true {
    budget = 12
    line = input("you> ")
    if line == null { break }        // EOF: a pipe that ran out
    line = line.trim()
    if line == "" { continue }
    if line.startswith(":") {
        // The commands that *change* something are handled here, in ov_main's own
        // scope. Done inside commands() they would assign to a local of that
        // function and report success while changing nothing -- which is what
        // :config model did before this moved.
        if line.startswith(":readonly ") {
            arg = line.slice(10, len(line)).trim()
            if arg == "on" or arg == "off" {
                guard_on = arg == "on"
                print("  guard " + arg)
            } else {
                print("  guard is " + (guard_on ? "on" : "off") + "  (:readonly on|off)")
            }
            continue
        }
        if line != ":config " and line.startswith(":config ") {
            what = line.slice(8, len(line))
            sp = what.indexof(" ")
            field = sp < 0 ? what : what.slice(0, sp)
            value = sp < 0 ? "" : what.slice(sp + 1, len(what)).trim()
            if field == "key" or field == "url" or field == "model" {
                if field == "key" { key = value }
                if field == "url" { url = value }
                if field == "model" { model = value }
                save_config()
                print("  " + field + " updated")
            } else {
                print("  :config key|url|model <value>")
            }
            continue
        }
        if !commands(line) { break }
        continue
    }

    // The deterministic layer first. An utterance this machine can answer
    // without a model is answered by this machine: "open chrome" resolves to
    // whatever browser is installed, "how big is /etc" to a du the agent runs
    // itself. Asking the model first is how you get "I cannot open Google
    // Chrome because I am running as an AI text assistant" -- true about the
    // model, useless to the person, and it is a sentence the agent now never
    // has to receive.
    hit = do_resolve(line)
    if hit["cmd"] != null {
        g = guard(hit["cmd"])
        if !g["ok"] {
            refused(g["why"])
        } else {
            result = run_tool({"cmd": hit["cmd"]})
            // A command run for its own sake is reported; a question is fed
            // back so the model can put it in words. Both show the command and
            // its exit status, which is the point.
            if !do_is_question(do_words(line)) {
                // Nothing to summarise: the command was the answer.
            } else {
                ai_ask(history, "You asked with a command, this ran:\n" +
                                "  " + hit["cmd"] + "\n" + result +
                                "\nNow answer in one short sentence. Do not " +
                                "claim you cannot run anything.")
                while budget > 0 {
                    budget = budget - 1
                    r = ai_request(url, key, model, ai_trim(history, 16), 60.0)
                    if !r["ok"] {
                        print("  ✖ model error: " + r["error"])
                        break
                    }
                    reply = r["text"].trim()
                    start = reply.indexof("{")
                    call = {}
                    if start < 0 {
                        // No protocol: say it, because the command already ran
                        // and the answer is real even if the model is chatty.
                        side("Ovyth: " + reply)
                        break
                    }
                    end = json_end(reply, start)
                    if end < 0 { side("Ovyth: " + reply); break }
                    try {
                        call = json.parse(reply.slice(start, end + 1))
                    } catch e {
                        side("Ovyth: " + reply)
                        break
                    }
                    if call["say"] != null {
                        side("Ovyth: " + call["say"])
                        ai_told(history, call["say"])
                        break
                    }
                    if call["cmd"] != null {
                        rg = guard(call["cmd"])
                        if !rg["ok"] { refused(rg["why"]); break }
                        ai_ask(history, run_tool({"cmd": call["cmd"]}))
                        continue
                    }
                    side("Ovyth: " + reply)
                    break
                }
            }
        }
        continue
    }

    ai_ask(history, line)

    // The model may take several tool turns before it answers.
    nudges = 0
    while budget > 0 {
        budget = budget - 1
        r = ai_request(url, key, model, ai_trim(history, 16), 60.0)
        if !r["ok"] {
            print("  ✖ model error: " + r["error"])
            break
        }
        reply = r["text"].trim()

        // No JSON at all. A model that answers from general knowledge instead of
        // looking is the commonest failure of a tool-using agent, so it is
        // nudged back to the protocol rather than shown to the user as if it
        // were an answer.
        start = reply.indexof("{")
        if start < 0 {
            // The reply is prose. Before nudging the model back to the
            // protocol, look for a command it may have left in a fence or in
            // backticks: a model asked for sizes very often answers in words
            // *and* writes du -h --max-depth=1 into a bash block. That command
            // is an answer the agent can act on, and discarding it is how an
            // agent ends up shrugging at something already sitting in front
            // of it.
            found = do_extract_commands(reply)
            if len(found) > 0 {
                ran = 0
                observations = []
                call = {}
                for c in found {
                    if ran >= 3 { break }
                    g = guard(c)
                    if !g["ok"] {
                        refused(g["why"])
                        continue
                    }
                    observations.push(run_tool({"cmd": c}))
                    ran = ran + 1
                }
                if ran > 0 {
                    ai_told(history, reply)
                    ai_ask(history, "These commands ran:\n" +
                                    do_join(observations, "\n---\n") +
                                    "\nAnswer in one short sentence from what " +
                                    "you actually observed. Do not claim you " +
                                    "cannot run anything.")
                    r2 = ai_request(url, key, model, ai_trim(history, 16), 60.0)
                    if r2["ok"] {
                        print("")
                        side("Ovyth: " + r2["text"].trim())
                    }
                    break
                }
            }
            nudges = nudges + 1
            if nudges > 2 {
                side(reply)
                break
            }
            ai_told(history, reply)
            ai_ask(history, "That was not a tool call. Reply with exactly one JSON " +
                            "object: {\"cmd\": \"...\"} to run a command, or " +
                            "{\"say\": \"...\"} to answer.")
            continue
        }
        nudges = 0
        end = json_end(reply, start)
        if end < 0 {
            print("  ✖ the model's reply was not a complete JSON object")
            break
        }

        call = {}
        try {
            call = json.parse(reply.slice(start, end + 1))
        } catch e {
            print("  ✖ json: " + str(e))
            ai_told(history, "That was not valid JSON. Reply with exactly one object.")
            continue
        }

        result = run_tool(call)
        if result != null {
            ai_ask(history, result)
            continue
        }

        if call["say"] != null {
            side("Ovyth: " + call["say"])
            ai_told(history, call["say"])
            break
        }
        if call["done"] != null {
            side("Ovyth: " + call["done"])
            break
        }
        print("  ✖ the model sent an object with no tool in it")
        ai_told(history, "That did not name a tool. Use cmd, read, write, or say.")
    }
}

print("")
print("bye")
