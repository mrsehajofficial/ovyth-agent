// agent :: guard.ov
//
// The guard: what an agent may and may not run.
//
// A guard, not a lockdown. Writing, installing, cloning and building are the
// point of an agent, and all of them are writes -- so the question is not
// "does this change anything" but "does this destroy something that cannot be
// built again". Those are few, and they are named: the system roots, the block
// devices, and the machine's power state.
//
// Everything else is allowed, deliberately. An agent that cannot write cannot
// work; the answer to "it might do something destructive" is a refusal it can
// see and adapt to, not a sandbox it cannot work in.
//
//   import "agent/guard"
//   g = guard(cmd)
//   if !g["ok"] { ... tell the model why ... }
//
// Two settings: AGENT_PROTECT=path:path for the paths a program cannot guess,
// and AGENT_UNSAFE=1 to disable it entirely.
//
// Library, not policy-with-a-printer: this returns a decision and the caller
// decides how to report it, so the same guard works for a chat and a batch run.

// The first path an `rm` invocation is pointed at, flags skipped.
//
// Only the leading command matters: a target inside a chain or a pipe is not
// what this rm deletes. Returns "" when there is no target to speak of.
function rm_target(c) {
    at = c.indexof("rm ")
    if at < 0 { return "" }
    rest = c.slice(at + 3)
    while rest.startswith("-") {
        sp = rest.indexof(" ")
        if sp < 0 { return "" }
        rest = rest.slice(sp + 1)
    }
    while rest.startswith(" ") { rest = rest.slice(1) }
    sp = rest.indexof(" ")
    return sp < 0 ? rest : rest.slice(0, sp)
}

// Expand "~" and "$HOME" to the real home directory.
//
// Both sides of the protected-path comparison have to be spelled the same way,
// and they are not: AGENT_PROTECT is usually written as $HOME/Work and the shell
// expands it before the agent ever sees it, while a command's target keeps its
// "$HOME/Work" spelling. Without this, protecting $HOME/Work silently does
// nothing -- the guard compares "/home/you/Work" against "$HOME/Work" and they
// never match.
function expand_home(t) {
    home = env_or("HOME", "")
    if t == "" or home == "" { return t }
    if t.startswith("~/") { return home + t.slice(1, len(t)) }
    if t.startswith("$HOME/") { return home + t.slice(5, len(t)) }
    return t
}

// Is this path one of the ones that cannot be rebuilt?
//
// Two sources, because no fixed list can know what matters to *this* user: the
// system roots plus the home directory itself, and AGENT_PROTECT for the rest.
// Everything else under $HOME is the agent's business -- ~/.cache, ~/.ovyth and
// ~/.local are all rebuildable, and an agent that cannot clear its own cache
// cannot do its job. Which subdirectories of $HOME matter is the user's call,
// which is what AGENT_PROTECT is for.
function is_protected_path(t) {
    if t == "" { return false }
    // /home is absent, deliberately: the rule below is "is a root or sits under
    // one", which would protect every user's home directory tree. The user's
    // *own* home is protected wholesale by the exact-match test instead.
    roots = ["/", "/usr", "/etc", "/bin", "/sbin", "/lib", "/lib64", "/boot",
             "/var", "/root", "/opt", "/proc", "/sys", "/dev", "/run"]
    for root in roots {
        if t == root or t == root + "/" or t.startswith(root + "/") { return true }
    }
    home = env_or("HOME", "")
    if t == "$HOME" or t == "$HOME/" or t == "~" or t == "~/" { return true }
    if home != "" and (t == home or t == home + "/") { return true }
    for extra in env_or("AGENT_PROTECT", "").split(":") {
        e = expand_home(extra.trim())
        if e == "" { continue }
        if t == e or t.startswith(e + "/") { return true }
    }
    return false
}

// Is this command allowed? Returns {"ok": true} or {"ok": false, "why": ...}.
function guard(cmd) {
    if env_or("AGENT_UNSAFE", "") != "" { return {"ok": true} }

    c = cmd.trim()
    if c == "" { return {"ok": true} }

    // Touching a disk or a device node: nothing an agent has reason to do.
    for pat in ["mkfs", "of=/dev/", ">/dev/sd", "> /dev/sd", ">/dev/nvme",
                "> /dev/nvme", ">/dev/vd", "> /dev/vd"] {
        if c.contains(pat) { return {"ok": false, "why": "writes to a disk or device"} }
    }

    // Stopping or restarting the machine mid-task.
    for pat in ["shutdown", "reboot", "poweroff", "halt", "init 0", "init 6",
                "systemctl poweroff", "systemctl reboot"] {
        if c.contains(pat) { return {"ok": false, "why": "changes the machine's power state"} }
    }

    // A fork bomb, which is destruction by resource rather than by intent.
    if c.contains(":(){") or c.contains(":() {") {
        return {"ok": false, "why": "a fork bomb"}
    }

    // Deletion, but only where the target cannot be rebuilt. `rm -rf /tmp/x`,
    // `rm -rf build` and `rm -rf ~/.cache` all stay allowed -- those are working
    // directories, and rebuilding them is the agent's own business.
    //
    // The target is *parsed*, not substring-matched. Matching "rm -rf /usr" as a
    // substring looks sufficient until it is tested: `rm -rf /` contains no such
    // substring and sailed straight through, as did `rm -rf $HOME`.
    if c.startswith("rm ") or c.contains(" rm ") {
        target = expand_home(rm_target(c))
        if is_protected_path(target) {
            return {"ok": false, "why": "deletes " + target +
                                      ", which is not rebuildable"}
        }
    }

    // Recursive permission changes on the same roots have the same effect.
    if (c.contains("chmod ") or c.contains("chown ")) and c.contains("-R") {
        for root in ["/usr", "/etc", "/bin", "/sbin", "/lib", "/boot", "/var"] {
            if c.contains(" " + root) or c.contains(" " + root + "/") {
                return {"ok": false, "why": "changes permissions on " + root +
                                          " recursively"}
            }
        }
    }

    // find -delete on a root is rm by another name.
    if c.contains("find ") and c.contains("-delete") {
        for root in ["/ /", "/usr", "/etc", "/bin", "/sbin"] {
            if c.contains(root) {
                return {"ok": false, "why": "deletes under " + root.trim()}
            }
        }
    }

    return {"ok": true}
}
